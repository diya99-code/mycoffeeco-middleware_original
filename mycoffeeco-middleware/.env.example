# Copy this file to .env and fill in real values

# Server
PORT=3000

# Rista API
RISTA_BASE_URL=https://api.ristaapps.com/v1
RISTA_API_KEY=YOUR_RISTA_API_KEY
RISTA_SECRET_KEY=YOUR_RISTA_SECRET_KEY
RISTA_BRANCH_CODE=YOUR_BRANCH_CODE

# Shopify
SHOPIFY_STORE=yourstore.myshopify.com
SHOPIFY_ACCESS_TOKEN=YOUR_SHOPIFY_ACCESS_TOKEN
SHOPIFY_WEBHOOK_SECRET=YOUR_SHOPIFY_WEBHOOK_SECRET
SHOPIFY_CALLBACK_URL=https://YOUR_DEPLOYED_URL/orders/status
SHOPIFY_STORE_URL=https://mycoffeeco.com

# Business
COMPANY_NAME=My Coffee Co
LOYALTY_PERCENTAGE=7

# Set to "true" during development/testing, "false" in production
MOCK_MODE=false
