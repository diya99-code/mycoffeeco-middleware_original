{% comment %}
  Ad Campaign Landing Page - DLF Cyber City Location
  
  This page is specifically designed for Meta and Google Ads campaigns.
  Features:
  - Hero banner with location info (separate images for mobile & desktop)
  - Get Directions CTA with working map
  - Product showcases
  - Store information and hours
  - Mobile-optimized design
  
  SEO: Set page to noindex to hide from main navigation
{% endcomment %}

<meta name="robots" content="noindex, nofollow">

<div class="ad-landing-page" id="dlf-landing">
  
  {%- comment -%} ══════════════ HERO SECTION ══════════════ {%- endcomment -%}
  <section class="hero-section">
    {%- if section.settings.hero_image_mobile != blank or section.settings.hero_image_desktop != blank -%}
      <div class="hero-image-container">
        
        {%- comment -%} Mobile Image {%- endcomment -%}
        {%- if section.settings.hero_image_mobile != blank -%}
          <img src="{{ section.settings.hero_image_mobile | image_url: width: 1200 }}" 
               alt="My Coffee Co. - Your next coffee is already downstairs" 
               class="hero-full-image hero-mobile-only"
               loading="eager">
        {%- endif -%}
        
        {%- comment -%} Desktop Image {%- endcomment -%}
        {%- if section.settings.hero_image_desktop != blank -%}
          <img src="{{ section.settings.hero_image_desktop | image_url: width: 2400 }}" 
               alt="My Coffee Co. - Your next coffee is already downstairs" 
               class="hero-full-image hero-desktop-only"
               loading="eager">
        {%- endif -%}
        
        {%- comment -%} Clickable button overlays - "Get Directions" and "Call Store" {%- endcomment -%}
        <a href="https://www.google.com/maps/dir/?api=1&destination={{ section.settings.store_latitude | default: '28.4943' }},{{ section.settings.store_longitude | default: '77.0868' }}&travelmode=walking" 
           target="_blank"
           class="hero-btn-overlay hero-btn-directions" 
           id="hero-directions-btn"
           aria-label="Get Directions">
          <span class="sr-only">Get Directions</span>
        </a>
        
        <a href="tel:{{ section.settings.phone | default: '+919876543210' }}" 
           class="hero-btn-overlay hero-btn-call" 
           id="hero-call-btn"
           aria-label="Call Store">
          <span class="sr-only">Call Store</span>
        </a>
      </div>
    {%- else -%}
      <div class="hero-placeholder">
        <p>📷 Upload your hero banners in the theme customizer</p>
        <p><strong>Mobile Banner:</strong> Upload vertical/square banner for mobile (recommended: 800x1200px)</p>
        <p><strong>Desktop Banner:</strong> Upload horizontal banner for desktop (recommended: 2000x400px)</p>
        <p><em>Both images: "Your next coffee is already downstairs"</em></p>
      </div>
    {%- endif -%}
  </section>
  
  {%- comment -%} ══════════════ FEATURE CARDS (After Hero) ══════════════ {%- endcomment -%}
  <section class="features-strip">
    <div class="container">
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-card-icon">🏢</div>
          <h3>Inside DLF</h3>
          <p>Conveniently located inside your building</p>
        </div>
        <div class="feature-card">
          <div class="feature-card-icon">⏱️</div>
          <h3>Ready in Minutes</h3>
          <p>Freshly brewed, served fast</p>
        </div>
        <div class="feature-card">
          <div class="feature-card-icon">☕</div>
          <h3>Specialty Arabica</h3>
          <p>Premium Indian Arabica beans</p>
        </div>
        <div class="feature-card">
          <div class="feature-card-icon">⭐</div>
          <h3>Premium Taste</h3>
          <p>Crafted for a richer, smoother experience</p>
        </div>
      </div>
    </div>
  </section>
  
  {%- comment -%} ══════════════ PRODUCT SHOWCASE (3 fixed cards, no blocks needed) ══════════════ {%- endcomment -%}
  <section class="products-section">
    <div class="container">
      <p class="section-label">WHY PEOPLE WALK HERE</p>
      <h2 class="section-title">Coffee that fits your day.</h2>
      
      <div class="product-grid">

        {%- comment -%} CARD 1 {%- endcomment -%}
        <div class="product-card">
          {%- if section.settings.card1_image != blank -%}
          <div class="product-image">
            <img src="{{ section.settings.card1_image | image_url: width: 400 }}" alt="{{ section.settings.card1_name }}" loading="lazy">
            <span class="product-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="#0a06ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="13" cy="4" r="2"/>
                <path d="M10.5 21l1-7-2-2 1-5"/>
                <path d="M13.5 6l2 3-1 3 3 2"/>
                <path d="M9 9l3-1"/>
                <path d="M14.5 21l-2-6"/>
              </svg>
            </span>
          </div>
          {%- else -%}
          <div class="product-image product-image-placeholder">
            <span class="placeholder-text">Upload photo: person holding cup</span>
            <span class="product-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="#0a06ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="13" cy="4" r="2"/>
                <path d="M10.5 21l1-7-2-2 1-5"/>
                <path d="M13.5 6l2 3-1 3 3 2"/>
                <path d="M9 9l3-1"/>
                <path d="M14.5 21l-2-6"/>
              </svg>
            </span>
          </div>
          {%- endif -%}
          <h3>{{ section.settings.card1_name | default: 'No Detour' }}</h3>
          <p>{{ section.settings.card1_description | default: 'Grab your coffee without leaving work.' }}</p>
        </div>

        {%- comment -%} CARD 2 {%- endcomment -%}
        <div class="product-card">
          {%- if section.settings.card2_image != blank -%}
          <div class="product-image">
            <img src="{{ section.settings.card2_image | image_url: width: 400 }}" alt="{{ section.settings.card2_name }}" loading="lazy">
            <span class="product-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="#0a06ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 8h1a4 4 0 1 1 0 8h-1"/>
                <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/>
                <line x1="6" y1="2" x2="6" y2="4"/>
                <line x1="10" y1="2" x2="10" y2="4"/>
                <line x1="14" y1="2" x2="14" y2="4"/>
              </svg>
            </span>
          </div>
          {%- else -%}
          <div class="product-image product-image-placeholder">
            <span class="placeholder-text">Upload photo: espresso pour</span>
            <span class="product-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="#0a06ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 8h1a4 4 0 1 1 0 8h-1"/>
                <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/>
                <line x1="6" y1="2" x2="6" y2="4"/>
                <line x1="10" y1="2" x2="10" y2="4"/>
                <line x1="14" y1="2" x2="14" y2="4"/>
              </svg>
            </span>
          </div>
          {%- endif -%}
          <h3>{{ section.settings.card2_name | default: 'Made Fresh' }}</h3>
          <p>{{ section.settings.card2_description | default: 'Every cup prepared to order.' }}</p>
        </div>

        {%- comment -%} CARD 3 {%- endcomment -%}
        <div class="product-card">
          {%- if section.settings.card3_image != blank -%}
          <div class="product-image">
            <img src="{{ section.settings.card3_image | image_url: width: 400 }}" alt="{{ section.settings.card3_name }}" loading="lazy">
            <span class="product-icon">
              <svg viewBox="0 0 24 24" fill="#0a06ff" stroke="#0a06ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
              </svg>
            </span>
          </div>
          {%- else -%}
          <div class="product-image product-image-placeholder">
            <span class="placeholder-text">Upload photo: laptop + mug</span>
            <span class="product-icon">
              <svg viewBox="0 0 24 24" fill="#0a06ff" stroke="#0a06ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
              </svg>
            </span>
          </div>
          {%- endif -%}
          <h3>{{ section.settings.card3_name | default: 'Worth the Pause' }}</h3>
          <p>{{ section.settings.card3_description | default: 'Small Sips. Big Moments.' }}</p>
        </div>

      </div>
    </div>
  </section>
  
  {%- comment -%} ══════════════ SIGNATURE DRINKS (3 fixed cards, no blocks needed) ══════════════ {%- endcomment -%}
  <section class="signature-section">
    <div class="container">
      <p class="section-label">SIGNATURE DRINKS</p>
      <h2 class="section-title">Crafted for the moments that matter.</h2>
      
      <div class="signature-grid">

        {%- comment -%} CARD 1 {%- endcomment -%}
        <div class="signature-card">
          {%- if section.settings.sig1_image != blank -%}
          <img src="{{ section.settings.sig1_image | image_url: width: 500 }}" alt="{{ section.settings.sig1_name }}" loading="lazy">
          {%- else -%}
          <div class="signature-image-placeholder">
            <span class="placeholder-text">Upload photo: Flat White</span>
          </div>
          {%- endif -%}
          <div class="signature-info">
            <div class="signature-text">
              <h3>{{ section.settings.sig1_name | default: 'Flat White' }}</h3>
              <p>{{ section.settings.sig1_description | default: 'Silky microfoam with a rich, smooth finish.' }}</p>
            </div>
            <button class="order-button" type="button" aria-label="Order {{ section.settings.sig1_name | default: 'Flat White' }}">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </button>
          </div>
        </div>

        {%- comment -%} CARD 2 {%- endcomment -%}
        <div class="signature-card">
          {%- if section.settings.sig2_image != blank -%}
          <img src="{{ section.settings.sig2_image | image_url: width: 500 }}" alt="{{ section.settings.sig2_name }}" loading="lazy">
          {%- else -%}
          <div class="signature-image-placeholder">
            <span class="placeholder-text">Upload photo: Iced Spanish Latte</span>
          </div>
          {%- endif -%}
          <div class="signature-info">
            <div class="signature-text">
              <h3>{{ section.settings.sig2_name | default: 'Iced Spanish Latte' }}</h3>
              <p>{{ section.settings.sig2_description | default: 'Sweet, creamy & bold. Perfect for your afternoon.' }}</p>
            </div>
            <button class="order-button" type="button" aria-label="Order {{ section.settings.sig2_name | default: 'Iced Spanish Latte' }}">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </button>
          </div>
        </div>

        {%- comment -%} CARD 3 {%- endcomment -%}
        <div class="signature-card">
          {%- if section.settings.sig3_image != blank -%}
          <img src="{{ section.settings.sig3_image | image_url: width: 500 }}" alt="{{ section.settings.sig3_name }}" loading="lazy">
          {%- else -%}
          <div class="signature-image-placeholder">
            <span class="placeholder-text">Upload photo: Cold Brew</span>
          </div>
          {%- endif -%}
          <div class="signature-info">
            <div class="signature-text">
              <h3>{{ section.settings.sig3_name | default: 'Cold Brew' }}</h3>
              <p>{{ section.settings.sig3_description | default: 'Smooth. Bold. Refreshingly clean.' }}</p>
            </div>
            <button class="order-button" type="button" aria-label="Order {{ section.settings.sig3_name | default: 'Cold Brew' }}">
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </button>
          </div>
        </div>

      </div>
    </div>
  </section>
  
  {%- comment -%} ══════════════ MAP SECTION ══════════════ {%- endcomment -%}
  <section class="map-section">
    <div class="container">
      <div class="map-grid">
        <div class="map-container" id="google-map">
          <iframe 
            width="100%" 
            height="400" 
            frameborder="0" 
            style="border:0" 
            src="https://www.google.com/maps/embed/v1/place?key={{ section.settings.google_maps_api_key }}&q={{ section.settings.map_query | default: 'My+Coffee+Co+DLF+Cyber+City+Gurgaon' | url_encode }}&zoom=16"
            allowfullscreen
            loading="lazy">
          </iframe>
          <button class="map-cta" id="map-directions" type="button">
            Get Directions
          </button>
        </div>
        
        <div class="store-info-card">
          <p class="info-label">FIND US</p>
          <h3>Inside DLF Cyber City</h3>
          
          <div class="info-row">
            <span class="info-icon">📍</span>
            <div>
              <strong>{{ section.settings.building_name | default: 'Building 14 • DLF Cyber City' }}</strong>
              <p>{{ section.settings.full_address | default: 'Sector 24, Gurugram, Haryana 122022' }}</p>
            </div>
          </div>
          
          <div class="info-row">
            <span class="info-icon">⏰</span>
            <div>
              <strong>Store Hours</strong>
              <p>{{ section.settings.weekday_hours | default: 'Monday - Friday: 8 AM - 10 PM' }}</p>
              <p>{{ section.settings.weekend_hours | default: 'Saturday: 9 AM - 6 PM' }}</p>
            </div>
          </div>
          
          <div class="info-row">
            <span class="info-icon">📞</span>
            <div>
              <strong>Contact</strong>
              <p>{{ section.settings.phone | default: '+91 98765 43210' }}</p>
            </div>
          </div>
          
          <button class="navigate-button" id="store-info-directions" type="button">
            <span class="nav-icon">🧭</span> Navigate Now
          </button>
          
          <p class="map-footnote">Get walking directions on Google Maps →</p>
        </div>
      </div>
    </div>
  </section>
  
  {%- comment -%} ══════════════ SOCIAL PROOF (3 fixed cards, no blocks needed) ══════════════ {%- endcomment -%}
  <section class="social-section">
    <div class="container">
      <p class="section-label">REAL MOMENTS. REAL PEOPLE.</p>
      
      <div class="social-grid">

        {%- comment -%} CARD 1 {%- endcomment -%}
        <div class="social-card">
          {%- if section.settings.social1_image != blank -%}
          <img src="{{ section.settings.social1_image | image_url: width: 400 }}" alt="{{ section.settings.social1_quote }}" loading="lazy">
          {%- else -%}
          <div class="social-image-placeholder">
            <span class="placeholder-text">Upload photo: morning coffee</span>
          </div>
          {%- endif -%}
          <div class="social-overlay">
            <p class="social-quote">"{{ section.settings.social1_quote | default: 'Morning ritual before stand-up.' }}"</p>
          </div>
        </div>

        {%- comment -%} CARD 2 {%- endcomment -%}
        <div class="social-card">
          {%- if section.settings.social2_image != blank -%}
          <img src="{{ section.settings.social2_image | image_url: width: 400 }}" alt="{{ section.settings.social2_quote }}" loading="lazy">
          {%- else -%}
          <div class="social-image-placeholder">
            <span class="placeholder-text">Upload photo: afternoon coffee</span>
          </div>
          {%- endif -%}
          <div class="social-overlay">
            <p class="social-quote">"{{ section.settings.social2_quote | default: 'Afternoon reset.' }}"</p>
          </div>
        </div>

        {%- comment -%} CARD 3 {%- endcomment -%}
        <div class="social-card">
          {%- if section.settings.social3_image != blank -%}
          <img src="{{ section.settings.social3_image | image_url: width: 400 }}" alt="{{ section.settings.social3_quote }}" loading="lazy">
          {%- else -%}
          <div class="social-image-placeholder">
            <span class="placeholder-text">Upload photo: coffee with coworker</span>
          </div>
          {%- endif -%}
          <div class="social-overlay">
            <p class="social-quote">"{{ section.settings.social3_quote | default: 'Coffee worth leaving your desk for.' }}"</p>
          </div>
        </div>

      </div>
    </div>
  </section>
  
  {%- comment -%} ══════════════ FINAL CTA ══════════════ {%- endcomment -%}
  <section class="final-cta-section">
    <div class="final-cta-grid">
      <div class="final-cta-image">
        {%- if section.settings.final_cta_image != blank -%}
        <img src="{{ section.settings.final_cta_image | image_url: width: 600 }}" alt="My Coffee Co. cup" loading="lazy">
        {%- else -%}
        <div class="final-cta-image-placeholder">
          <span class="placeholder-text">Upload photo: hand holding coffee cup</span>
        </div>
        {%- endif -%}
      </div>

      <div class="final-cta-content">
        <h2 class="cta-title">
          {{ section.settings.cta_title_line1 | default: 'Your next coffee is' }}<br>
          {{ section.settings.cta_title_line2_prefix | default: 'already' }} <span class="blue-text">{{ section.settings.cta_title_line2_highlight | default: 'downstairs' }}</span>.
        </h2>
        <p class="cta-subtitle">{{ section.settings.cta_subtitle | default: 'Skip the queue. Skip the detour. Just great coffee.' }}</p>
      </div>

      <div class="final-buttons">
        <button class="cta-button primary" id="final-directions" type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" y1="2" x2="11" y2="13"/>
            <polygon points="22 2 15 22 11 13 2 9 22 2"/>
          </svg>
          Get Directions
        </button>
        <button class="cta-button secondary" id="call-store" type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke="#0a06ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          Call Store
        </button>
      </div>
    </div>
  </section>
  
  {%- comment -%} ══════════════ STICKY FOOTER BAR ══════════════ {%- endcomment -%}
  <div class="sticky-footer-bar" id="sticky-footer">
    <div class="footer-content">
      <div class="footer-location">
        <span class="pin-icon">📍</span>
        <div>
          <strong>{{ section.settings.location_short | default: 'Building 14 • DLF Cyber City' }}</strong>
          <small>{{ section.settings.distance | default: '2 min walk from your desk' }}</small>
        </div>
      </div>
      <div class="footer-actions">
        <button class="footer-button" id="sticky-directions" type="button">
          <span class="nav-icon">🧭</span> Get Directions
        </button>
        <button class="footer-button secondary" id="sticky-call" type="button">
          <span class="phone-icon">📞</span>
        </button>
      </div>
    </div>
  </div>
  
</div>

<style>
  /* ══════════════ RESET & BASE ══════════════ */
  .ad-landing-page {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
    color: #1a1a1a;
    line-height: 1.6;
    background: #ffffff;
  }
  
  .ad-landing-page * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  
  /* ══════════════ HERO SECTION (Horizontal Banner) ══════════════ */
  .hero-section {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0;
    background: #fff;
    overflow: hidden;
  }
  
  .hero-image-container {
    position: relative;
    width: 100%;
    margin: 0;
    padding: 0;
    display: block;
    line-height: 0;
  }
  
  .hero-full-image {
    width: 100%;
    height: auto;
    display: block;
    margin: 0;
    padding: 0;
    border: none;
    outline: none;
  }
  
  /* Mobile/Desktop Image Switching */
  .hero-mobile-only {
    display: block;
  }
  
  .hero-desktop-only {
    display: none;
  }
  
  @media (min-width: 769px) {
    .hero-mobile-only {
      display: none;
    }
    
    .hero-desktop-only {
      display: block;
    }
  }
  
  /* Clickable button overlays - "Get Directions" (blue) and "Call Store" (white) */
  .hero-btn-overlay {
    position: absolute;
    background: transparent;
    border: none;
    cursor: pointer;
    z-index: 10;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  
  .hero-btn-overlay:hover {
    opacity: 0.9;
  }
  
  .hero-btn-overlay:focus {
    outline: 2px solid rgba(0, 91, 255, 0.8);
    outline-offset: 2px;
  }
  
  /* Get Directions button (blue, top right) */
  .hero-btn-directions {
    top: 32%;
    right: 6%;
    width: 16%;
    height: 22%;
  }
  
  /* Call Store button (white, below Get Directions) */
  .hero-btn-call {
    top: 58%;
    right: 6%;
    width: 16%;
    height: 22%;
  }
  
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  
  .hero-placeholder {
    padding: 80px 20px;
    text-align: center;
    background: #f8f9fa;
    color: #6c757d;
  }
  
  .hero-placeholder p {
    margin: 8px 0;
    font-size: 14px;
  }
  
  .hero-placeholder strong {
    color: #1a1a1a;
  }
  
  /* Mobile responsive */
  @media (max-width: 768px) {
    /* Adjust button positions for mobile */
    .hero-btn-directions {
      top: 30%;
      right: 5%;
      width: 42%;
      height: 26%;
    }
    
    .hero-btn-call {
      top: 60%;
      right: 5%;
