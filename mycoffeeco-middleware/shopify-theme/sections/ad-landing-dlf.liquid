<script>
(function() {
  'use strict';
  
  // Google Maps directions link
  const mapsQuery = {{ section.settings.maps_query | default: 'My Coffee Co, Building 14, DLF Cyber City, Gurgaon' | json }};
  const storeLat = {{ section.settings.store_latitude | default: '28.4943' }};
  const storeLng = {{ section.settings.store_longitude | default: '77.0868' }};
  const storePhone = {{ section.settings.phone | default: '+919876543210' | json }};
  
  // Generate Google Maps URL
  function getDirectionsURL() {
    return `https://www.google.com/maps/dir/?api=1&destination=${storeLat},${storeLng}&destination_place_id=&travelmode=walking`;
  }
  
  // Open Google Maps directions
  function openDirections() {
    window.open(getDirectionsURL(), '_blank');
  }
  
  // Call store
  function callStore() {
    window.location.href = `tel:${storePhone}`;
  }
  
  // Attach click handlers
  document.querySelectorAll('#hero-directions, #main-directions, #map-directions, #store-info-directions, #final-directions, #sticky-directions').forEach(btn => {
    btn.addEventListener('click', openDirections);
  });
  
  document.querySelectorAll('#call-store, #sticky-call').forEach(btn => {
    btn.addEventListener('click', callStore);
  });
  
  // Sticky footer bar on scroll
  const stickyFooter = document.getElementById('sticky-footer');
  let scrollTimeout;
  
  window.addEventListener('scroll', () => {
    clearTimeout(scrollTimeout);
    
    if (window.scrollY > 500) {
      stickyFooter.classList.add('visible');
    }
    
    scrollTimeout = setTimeout(() => {
      if (window.scrollY < 300) {
        stickyFooter.classList.remove('visible');
      }
    }, 100);
  });
  
  // Analytics tracking (if GTM/GA is installed)
  function trackEvent(action, label) {
    if (typeof gtag !== 'undefined') {
      gtag('event', action, {
        'event_category': 'Ad Landing Page',
        'event_label': label
      });
    }
    console.log('[Analytics]', action, label);
  }
  
  // Track CTA clicks
  document.querySelectorAll('[id$="-directions"]').forEach(btn => {
    btn.addEventListener('click', () => {
      trackEvent('click', 'Get Directions - ' + btn.id);
    });
  });
  
  document.querySelectorAll('[id$="-call"]').forEach(btn => {
    btn.addEventListener('click', () => {
      trackEvent('click', 'Call Store - ' + btn.id);
    });
  });
  
  // Track scroll depth
  let scrollDepths = [25, 50, 75, 100];
  let trackedDepths = [];
  
  window.addEventListener('scroll', () => {
    const scrollPercent = (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100;
    
    scrollDepths.forEach(depth => {
      if (scrollPercent >= depth && !trackedDepths.includes(depth)) {
        trackedDepths.push(depth);
        trackEvent('scroll', `Scroll Depth ${depth}%`);
      }
    });
  });
  
})();
</script>

