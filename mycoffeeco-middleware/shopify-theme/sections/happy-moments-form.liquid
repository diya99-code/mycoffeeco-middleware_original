{% comment %}
  Happy Moments Event Inquiry Form
  Sends all inquiry submissions directly to social@mycoffeeco.com
{% endcomment %}

<div class="hm-form-wrapper" id="happy-moments-section">
  <div class="hm-container">
    <div class="hm-header">
      <span class="hm-badge">☕ MY COFFEE CO. EVENTS</span>
      <h2 class="hm-title">Share Your Happy Moments With Us</h2>
      <p class="hm-subtitle">Planning a corporate event, party, or celebration? Let us bring specialty coffee to your guests!</p>
    </div>

    {%- if request.params.submitted == 'true' -%}
      <div class="hm-alert-success">
        🎉 <strong>Thank you!</strong> Your inquiry has been sent to <strong>social@mycoffeeco.com</strong>. Our team will contact you shortly!
      </div>
    {%- endif -%}

    <!-- FormSubmit direct email forwarding to social@mycoffeeco.com -->
    <form action="https://formsubmit.co/social@mycoffeeco.com" method="POST" class="hm-form">
      
      <!-- FormSubmit Configuration -->
      <input type="hidden" name="_subject" value="🎉 New Happy Moments Lead Inquiry - My Coffee Co.">
      <input type="hidden" name="_next" value="{{ canonical_url }}?submitted=true#happy-moments-section">
      <input type="hidden" name="_template" value="table">
      <input type="hidden" name="_captcha" value="false">

      <div class="hm-form-grid">

        <!-- Full Name -->
        <div class="hm-field-group">
          <label for="hm-name">Full Name <span class="req">*</span></label>
          <input type="text" id="hm-name" name="Full Name" placeholder="e.g. Rahul Sharma" required>
        </div>

        <!-- Phone Number -->
        <div class="hm-field-group">
          <label for="hm-phone">Mobile Number <span class="req">*</span></label>
          <div class="hm-phone-input">
            <span class="hm-prefix">🇮🇳 +91</span>
            <input type="tel" id="hm-phone" name="Mobile Number" placeholder="10-digit mobile number" pattern="[0-9]{10}" maxlength="10" required>
          </div>
        </div>

        <!-- Email Address -->
        <div class="hm-field-group">
          <label for="hm-email">Email Address <span class="req">*</span></label>
          <input type="email" id="hm-email" name="Email Address" placeholder="name@example.com" required>
        </div>

        <!-- Event Type -->
        <div class="hm-field-group">
          <label for="hm-event-type">Event Type</label>
          <select id="hm-event-type" name="Event Type">
            <option value="Corporate Coffee Setup">Corporate Coffee Setup</option>
            <option value="Birthday & Private Party">Birthday & Private Party</option>
            <option value="Wedding / Celebration">Wedding / Celebration</option>
            <option value="Office Pop-up Kiosk">Office Pop-up Kiosk</option>
            <option value="Other Happy Moment">Other Happy Moment</option>
          </select>
        </div>

        <!-- Expected Guests -->
        <div class="hm-field-group">
          <label for="hm-guests">Expected Guests</label>
          <input type="number" id="hm-guests" name="Expected Guests" placeholder="e.g. 50" min="1">
        </div>

        <!-- Preferred Date -->
        <div class="hm-field-group">
          <label for="hm-date">Event Date</label>
          <input type="date" id="hm-date" name="Event Date">
        </div>

        <!-- Message / Special Instructions -->
        <div class="hm-field-group hm-full-width">
          <label for="hm-message">Event Details & Special Notes <span class="req">*</span></label>
          <textarea id="hm-message" name="Message & Details" rows="4" placeholder="Tell us location, preferred coffee items, timing, or special requests..." required></textarea>
        </div>

      </div>

      <div class="hm-submit-wrap">
        <button type="submit" class="hm-submit-btn">
          <span>Submit Inquiry</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        </button>
      </div>

    </form>
  </div>
</div>

<style>
  .hm-form-wrapper { padding: 40px 16px; background: #fafafa; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
  .hm-container { max-width: 680px; margin: 0 auto; background: #ffffff; border-radius: 16px; padding: 32px 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); border: 1px solid #eaeaea; }
  .hm-header { text-align: center; margin-bottom: 28px; }
  .hm-badge { display: inline-block; background: #EEF2FF; color: #0A06FF; font-size: 12px; font-weight: 700; padding: 4px 12px; border-radius: 100px; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px; }
  .hm-title { font-size: 26px; font-weight: 800; color: #111827; margin: 0 0 8px 0; }
  .hm-subtitle { font-size: 14px; color: #6B7280; margin: 0; line-height: 1.5; }
  .hm-alert-success { background: #ECFDF5; border: 1px solid #10B981; color: #065F46; padding: 14px 16px; border-radius: 10px; font-size: 14px; margin-bottom: 24px; text-align: center; }
  .hm-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 600px) { .hm-form-grid { grid-template-columns: 1fr; } }
  .hm-field-group { display: flex; flex-direction: column; }
  .hm-field-group.hm-full-width { grid-column: 1 / -1; }
  .hm-field-group label { font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 6px; }
  .hm-field-group label .req { color: #EF4444; }
  .hm-field-group input, .hm-field-group select, .hm-field-group textarea { width: 100%; padding: 11px 14px; border: 1px solid #D1D5DB; border-radius: 8px; font-size: 14px; color: #111827; background: #fff; transition: border-color 0.2s, box-shadow 0.2s; }
  .hm-field-group input:focus, .hm-field-group select:focus, .hm-field-group textarea:focus { outline: none; border-color: #0A06FF; box-shadow: 0 0 0 3px rgba(10, 6, 255, 0.1); }
  .hm-phone-input { display: flex; align-items: center; }
  .hm-prefix { background: #F3F4F6; border: 1px solid #D1D5DB; border-right: none; border-radius: 8px 0 0 8px; padding: 11px 10px; font-size: 13px; font-weight: 600; color: #374151; white-space: nowrap; }
  .hm-phone-input input { border-radius: 0 8px 8px 0; }
  .hm-submit-wrap { margin-top: 24px; text-align: center; }
  .hm-submit-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; width: 100%; padding: 14px 24px; background: #0A06FF; color: #ffffff; border: none; border-radius: 10px; font-size: 16px; font-weight: 700; cursor: pointer; transition: background-color 0.2s; }
  .hm-submit-btn:hover { background: #0805cf; }
</style>

{% schema %}
{
  "name": "Happy Moments Form",
  "settings": [],
  "presets": [
    {
      "name": "Happy Moments Form"
    }
  ]
}
{% endschema %}
