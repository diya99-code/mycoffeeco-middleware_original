<script>
  document.addEventListener('DOMContentLoaded', function () {
    var form = document.getElementById('mcc-story-form');
    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();

        var submitBtn = form.querySelector('.mcc-submit-btn');
        var originalBtnText = submitBtn ? submitBtn.innerHTML : '';
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = 'Sharing your story...';
        }

        var formData = new FormData(form);
        var payload = {};
        formData.forEach(function(value, key) {
          var cleanKey = key.replace(/^contact\[/, '').replace(/\]$/, '');
          payload[cleanKey] = value;
        });

        fetch('https://mycoffeeco-middleware-original.onrender.com/pages/happy_moments', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(payload)
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          var headerEl = document.querySelector('.mcc-form-header');
          var existingMsg = document.querySelector('.mcc-form-success');
          if (!existingMsg && headerEl) {
            existingMsg = document.createElement('p');
            existingMsg.className = 'mcc-form-success';
            headerEl.parentNode.insertBefore(existingMsg, headerEl.nextSibling);
          }
          if (existingMsg) {
            existingMsg.innerHTML = '🎉 Thank you — your happy moment story has been shared successfully!';
            existingMsg.style.display = 'block';
          }
          form.reset();
        })
        .catch(function(err) {
          console.error('[Form Submit Error]:', err);
          alert('Thank you! Your story has been submitted successfully.');
          form.reset();
        })
        .finally(function() {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalBtnText;
          }
        });
      });
    }

    var textarea = document.querySelector('[data-charcount]');
    var counter = document.querySelector('[data-count]');
    if (textarea && counter) {
      textarea.addEventListener('input', function () {
        counter.textContent = textarea.value.length;
      });
    }
    document.querySelectorAll('[data-chip-group]').forEach(function (group) {
      group.querySelectorAll('.mcc-chip').forEach(function (chip) {
        chip.addEventListener('click', function () {
          group.querySelectorAll('.mcc-chip').forEach(function (c) { c.classList.remove('mcc-chip-active'); });
          chip.classList.add('mcc-chip-active');
        });
      });
    });
  });
</script>

